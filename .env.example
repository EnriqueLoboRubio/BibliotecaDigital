# Supabase Configuration
# Sustituye con tus credenciales de Supabase (Settings > API en app.supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Google Gemini API (Opcional, para digitalización asistida por fotos de estantería)
# Consigue una clave gratuita en: https://aistudio.google.com/
GEMINI_API_KEY=tu-gemini-api-key
